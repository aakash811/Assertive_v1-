# ====================================
# Database
# ====================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/assertive


# ====================================
# Server
# ====================================

PORT=4321

NODE_ENV=development


# ====================================
# API
# ====================================

ASSERTIVE_API_URL=http://localhost:4321/api

ASSERTIVE_API_KEY=replace_me


# ====================================
# Storage
# ====================================

STORAGE_PROVIDER=local


# ====================================
# S3
# ====================================

S3_BUCKET=

S3_REGION=

S3_ACCESS_KEY=

S3_SECRET_KEY=


# ====================================
# PGlite
# ====================================

PGLITE_PATH=.assertive/pgdata


# ====================================
# Retention
# ====================================

RETENTION_RUNS=90d

RETENTION_HISTORY=1y

RETENTION_TRACES=30d